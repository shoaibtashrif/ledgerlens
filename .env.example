# LedgerLens Environment Configuration (Optional)
# You can also enter and test these keys directly in the Web UI!

# Groq API Key (High-speed LPU inference with Qwen 3.8 27B)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI API Key (Cloud fallback with GPT-4o-mini)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Local Ollama endpoint (detected automatically if running on port 11434)
# OLLAMA_BASE_URL=http://localhost:11434/v1
